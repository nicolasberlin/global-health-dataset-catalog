# Local test: run python3 scripts/setup_api.py to generate this file automatically.
# Manual setup: copy this template to .env.api-client (private, excluded from Git).
# The client automatically loads .env.api-client on each run.

# Address of the running API; keep this value for the standalone Docker setup.
API_BASE_URL=http://127.0.0.1:8001

# Access token for YOUR backend. setup_api.py copies it from the local configuration.
# Manual setup: copy the token VALUE from API_ACCESS_TOKENS in .env.api.
# Example: API_ACCESS_TOKENS='{"tester":"abc..."}' -> API_TOKEN=abc...
# This is not an RCP key. Keep the completed file private.
API_TOKEN=
