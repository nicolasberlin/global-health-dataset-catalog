# Optional client configuration. Local defaults work without this file.
# The local API address defaults to http://127.0.0.1:8001.
API_CLIENT_MODE=local
# For a public API: set API_CLIENT_MODE=public and the exact website origin below.
# API_BASE_URL=https://catalog.example.org/api
# API_PUBLIC_ORIGIN=https://catalog.example.org
# The client obtains and saves a signed visitor cookie automatically in public mode.
