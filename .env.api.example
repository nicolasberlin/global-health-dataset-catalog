# Recommended: run python3 scripts/setup_api.py, then fill only the three RCP keys below.
# It creates .env.api with random credentials and a matching .env.api-client for tests.
# Manual setup: copy to .env.api and replace placeholders. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-database-password
# Each token identifies one stable owner; use a separate token per integration.
API_ACCESS_TOKENS='{"my-integration":"replace-with-a-random-token-of-at-least-32-characters"}'
RCP_DEEPSEEK_API_KEY=replace-me
RCP_GEMMA_MEDITRON_API_KEY=replace-me
RCP_APERTUS_MEDITRON_API_KEY=replace-me
API_PORT=8001
API_BIND_ADDRESS=127.0.0.1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEARCH_MAX_CONCURRENCY=1
SEARCH_MAX_ACTIVE=100
API_MAX_REQUEST_BODY_BYTES=65536
API_REQUEST_BODY_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_MIGRATE_ON_STARTUP=true
WORKER_SHUTDOWN_TIMEOUT_SECONDS=10

# Total attempts, including the first call. Set both attempt limits to 1 to disable retries.
LLM_MAX_ATTEMPTS=3
LLM_INVALID_MAX_ATTEMPTS=2
LLM_RETRY_WINDOW_SECONDS=120

# Execution window per collection cycle, including automatic retry waits.
COLLECTION_MAX_DURATION_SECONDS=300

# Optional JavaScript fallback. Enable the Compose "browser" profile as documented.
# The same random token (at least 32 characters) authenticates API and browser service.
COLLECTION_BROWSER_URL=
COLLECTION_BROWSER_TOKEN=
COLLECTION_BROWSER_HOSTS=dataverse.harvard.edu
COLLECTION_DATAVERSE_HOSTS=dataverse.harvard.edu,dataverse.unc.edu
COLLECTION_ZENODO_HOSTS=zenodo.org
