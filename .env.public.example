# Future public deployment. Copy to a private .env.public, excluded from Git.
# Generate each secret once; preserve the PostgreSQL password and session secret.
API_AUTH_MODE=public
POSTGRES_USER=global_health
POSTGRES_DB=global_health
POSTGRES_PASSWORD=
API_PUBLIC_ORIGIN=https://catalog.example.org
API_SESSION_SECRET=
API_ALLOW_INSECURE_HTTP_SESSIONS=false
API_CORS_ORIGINS=
RCP_DEEPSEEK_API_KEY=replace-me
RCP_GEMMA_MEDITRON_API_KEY=replace-me
RCP_APERTUS_MEDITRON_API_KEY=replace-me
# Set to the verified reverse proxy peer, never *.
FORWARDED_ALLOW_IPS=127.0.0.1
API_PORT=8001
API_BIND_ADDRESS=127.0.0.1
API_PUBLIC_SESSIONS_PER_IP_PER_MINUTE=20
API_PUBLIC_SEARCHES_PER_IP_PER_MINUTE=30
API_PUBLIC_CLASSIFICATIONS_PER_IP_PER_MINUTE=60
API_PUBLIC_ONLINE_SEARCHES_PER_DAY=500
API_PUBLIC_WORK_ITEMS_PER_DAY=500
API_PUBLIC_MAX_ACTIVE_WORK_ITEMS=100
API_PUBLIC_MAX_CANDIDATES_PER_SEARCH=10
