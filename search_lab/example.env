# Copy to search_lab/.env; start.sh loads this optional private file.
# Never commit credentials. The main API does not load this lab configuration.
LAB_API_BASE_URL=http://127.0.0.1:8001
# Use a dedicated SELECT-only role on the database observed by the lab.
LAB_DATABASE_URL=postgresql://lab_reader:replace-with-password@127.0.0.1:5432/global_health
# Lab snapshots and scenarios use search_lab/data/evidence by default.
# LAB_EVIDENCE_DIR=/absolute/path/to/search_lab/data/evidence
API_AUTH_MODE=local
